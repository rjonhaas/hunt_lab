# .env.tracecat.example — copy to .env.tracecat and fill in secrets before
# starting the Tracecat overlay.
#
#   cp .env.tracecat.example .env.tracecat
#   # Generate secrets (see instructions below), then:
#   docker compose -f docker-compose.tracecat.yml --env-file .env.tracecat up -d

# ── Tracecat image ─────────────────────────────────────────────────────────────
TRACECAT__IMAGE_TAG=1.0.0-beta.47

# ── Public URLs ────────────────────────────────────────────────────────────────
# Replace 192.168.56.10 if you've changed the docker-host IP.
TRACECAT__PUBLIC_APP_URL=http://192.168.56.10:8089
TRACECAT__PUBLIC_API_URL=http://192.168.56.10:8089/api

# Allowed CORS origins — include any host browsers will use to access the UI.
TRACECAT__ALLOW_ORIGINS=http://192.168.56.10:8089,http://localhost:8089

# ── Required secrets ───────────────────────────────────────────────────────────
#
# Generate each secret with the command shown in the comment.
# Never reuse these values across environments.

# 32-byte hex key for internal service-to-service auth.
#   openssl rand -hex 32
TRACECAT__SERVICE_KEY=REPLACE_ME_openssl_rand_hex_32

# 32-byte hex key for JWT signing.
#   openssl rand -hex 32
TRACECAT__SIGNING_SECRET=REPLACE_ME_openssl_rand_hex_32

# Fernet key for encrypting secrets stored in the database.
# Must be a URL-safe base64-encoded 32-byte key.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Or (same result):
#   openssl rand -base64 32
TRACECAT__DB_ENCRYPTION_KEY=REPLACE_ME_fernet_key

# 32-byte hex key for user session tokens.
#   openssl rand -hex 32
USER_AUTH_SECRET=REPLACE_ME_openssl_rand_hex_32

# ── First user (superadmin) ────────────────────────────────────────────────────
# This email + a password you set on first login becomes the admin account.
TRACECAT__AUTH_SUPERADMIN_EMAIL=admin@lab.local

# Authentication type — 'basic' = email/password (fine for a local lab).
TRACECAT__AUTH_TYPES=basic

# Restrict signup to specific email domains (leave empty to allow any).
TRACECAT__AUTH_ALLOWED_DOMAINS=

# ── Tracecat PostgreSQL ────────────────────────────────────────────────────────
TRACECAT__POSTGRES_USER=tracecat
TRACECAT__POSTGRES_PASSWORD=TracecatDB2026!

# Full DB connection URI — must match user/password/host above.
TRACECAT__DB_URI=postgresql+psycopg://tracecat:TracecatDB2026!@tracecat-postgres:5432/tracecat
TRACECAT__DB_SSLMODE=disable

# ── Temporal PostgreSQL ────────────────────────────────────────────────────────
TEMPORAL__POSTGRES_USER=temporal
TEMPORAL__POSTGRES_PASSWORD=TemporalDB2026!

# Temporal cluster connection (internal Docker hostname).
TEMPORAL__CLUSTER_URL=tracecat-temporal:7233
TEMPORAL__CLUSTER_NAMESPACE=default
TEMPORAL__CLUSTER_QUEUE=workflow

# ── MinIO (blob / artifact storage) ───────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=MinioLab2026!

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://tracecat-redis:6379

# ── Log level ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
